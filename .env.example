# Copy to .env for local use, or add these in Vercel → Project → Settings → Environment Variables.
# Never commit a real .env file.

# Optional. Leave empty to run without AI (barcodes + Open Food Facts only).
# With a key, photos without a readable barcode are sent to Google Gemini to read the label.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Max AI label reads per server instance per day (also set a quota in Google Cloud).
AI_DAILY_LIMIT=200

# Set to 1 only on your own computer.
FLASK_DEBUG=0

# Shown in the footer and policies. Leave blank to hide.
SITE_NAME=Scan Before Use
SITE_OWNER=
CONTACT_EMAIL=
CONTACT_PHONE=
BUSINESS_ADDRESS=

# Extra origins allowed to call the API from a browser (comma separated). Usually empty.
ALLOWED_ORIGINS=
# Shared rate-limit storage across serverless instances, e.g. an Upstash Redis URL: rediss://...
# RATELIMIT_STORAGE_URI=memory://
OPENFOODFACTS_USER_AGENT=ScanBeforeUse/3.0 (contact: you@example.com)
