# Food Product Scanner - Environment Variables Template
# Copy this file to .env and add your actual API keys

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-this-in-production
FLASK_DEBUG=True

# Gemini AI API Key (Required for AI analysis)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Open Food Facts API
OPENFOODFACTS_USER_AGENT=FoodScanner/1.0

# Optional: Other API Keys (uncomment and add if needed)
# USDA_API_KEY=your-usda-api-key
# SPOONACULAR_API_KEY=your-spoonacular-api-key
# EDAMAM_API_KEY=your-edamam-api-key
# EDAMAM_APP_ID=your-edamam-app-id

# Database Configuration (optional)
# DATABASE_URL=sqlite:///food_scanner.db

# Session Configuration
SESSION_PERMANENT=True
PERMANENT_SESSION_LIFETIME=86400
